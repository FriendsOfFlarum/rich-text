{
  "name": "@fof/rich-text",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "markdown-it": "^14.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-latex2img": "0.0.6"
  },
  "devDependencies": {
    "prettier": "^3.0.3",
    "flarum-webpack-config": "^3.1.0",
    "flarum-tsconfig": "^2.0.0",
    "webpack": "^5.65.0",
    "webpack-cli": "^7.2.3",
    "@flarum/prettier-config": "^1.0.0",
    "cross-env": "^7.0.0",
    "jsdom": "^26.1.0",
    "jquery": "^3.7.1",
    "clsx": "^2.1.1",
    "textarea-caret": "^3.1.0",
    "mithril": "^2.3.8",
    "typescript": "^5.9.3",
    "typescript-coverage-report": "^0.6.1",
    "vite": "^7.0.0",
    "vitest": "~4.0.18"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "format": "prettier --write src tests vitest.config.mts tsconfig.test.json",
    "format-check": "prettier --check src tests vitest.config.mts tsconfig.test.json",
    "clean-typings": "npx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "yarn run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && yarn run post-build-typings",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false && tsc --project tsconfig.test.json",
    "check-typings-coverage": "typescript-coverage-report --threshold 80 --ignore-files 'src/common/**/*'"
  },
  "prettier": "@flarum/prettier-config"
}
